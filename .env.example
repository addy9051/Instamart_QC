INSTA_AUDIT_ENVIRONMENT=development
# Set before production deployments.
INSTA_AUDIT_API_KEY=
INSTA_AUDIT_SKU_BANK_PATH=artifacts/sku_bank.npz
# Use a local Hugging Face snapshot directory; API startup never downloads model weights.
INSTA_AUDIT_EMBEDDING_MODEL_PATH=facebook/dinov2-small
INSTA_AUDIT_FRESHNESS_MODEL_PATH=artifacts/freshness.ts
INSTA_AUDIT_ENABLE_OCR=false
INSTA_AUDIT_OCR_DET_MODEL_DIR=
INSTA_AUDIT_OCR_REC_MODEL_DIR=
INSTA_AUDIT_OCR_CLS_MODEL_DIR=
INSTA_AUDIT_MIN_VISUAL_SIMILARITY=0.5
INSTA_AUDIT_MATCH_MARGIN=0.03
INSTA_AUDIT_LOOKALIKE_MARGIN=0.06

# Inference limits: workers, extra queued requests, wait for a slot (503), per-call timeout (504).
INSTA_AUDIT_MAX_CONCURRENT_INFERENCE=2
INSTA_AUDIT_INFERENCE_MAX_QUEUE=8
INSTA_AUDIT_INFERENCE_WAIT_SECONDS=10
INSTA_AUDIT_INFERENCE_TIMEOUT_SECONDS=30
# Refuse to start when the embedder and SKU bank were built with different models.
INSTA_AUDIT_STRICT_MODEL_CHECK=true
# Optional ONNX Runtime embedder (pip install -e ".[onnx]"); validate with scripts/check_onnx_parity.py.
INSTA_AUDIT_ONNX_EMBEDDER_PATH=

# Freshness policy: costs set the review threshold; temperature is read from the checkpoint metadata.
INSTA_AUDIT_FRESHNESS_COST_MISSED_ROTTEN=5
INSTA_AUDIT_FRESHNESS_COST_FALSE_REJECT=1
INSTA_AUDIT_COMMODITY_PROTOTYPES_PATH=

# Operating mode (off|shadow|advisory|enforce) comes from configs/modes.yaml; start in shadow.
INSTA_AUDIT_KILL_SWITCH=false
# Hard blocks stay disabled until the per-order false-hold gate is met on real store data.
INSTA_AUDIT_ALLOW_ENFORCE=false
# Seal-weight check: calibrate sigma from a known-weight test on the real scale.
INSTA_AUDIT_SCALE_SIGMA_G=2.0
INSTA_AUDIT_SEAL_RELATIVE_TOLERANCE_PCT=3.0

# Order data: signed OMS webhook (POST /v1/orders/webhook) and optional signed result post-back.
INSTA_AUDIT_WEBHOOK_SECRET=
INSTA_AUDIT_WEBHOOK_RESULT_URL=
# Local pilots/tests: JSON list of orders (see docs/oms_webhook_contract.md).
INSTA_AUDIT_MOCK_ORDERS_PATH=

# Proof-of-pack (opt-in). Needs legal/PIA sign-off before capturing real footage.
INSTA_AUDIT_PROOF_ENABLED=false
INSTA_AUDIT_PROOF_STORE=local
INSTA_AUDIT_PROOF_LOCAL_DIR=artifacts/proof
INSTA_AUDIT_PROOF_S3_BUCKET=
INSTA_AUDIT_PROOF_S3_PREFIX=
INSTA_AUDIT_PROOF_S3_ENDPOINT_URL=
INSTA_AUDIT_PROOF_SIGNING_KEY=
INSTA_AUDIT_PROOF_RETENTION_DAYS=30
# Normalized left,top,right,bottom of the bag mouth; label zones to blur, separated by ';'.
INSTA_AUDIT_PROOF_ROI=0,0,1,1
INSTA_AUDIT_PROOF_BLUR_BOXES=

